rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAuthor() {
      return signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /posts/{postId} {
      allow read: if resource.data.published == true ||
        (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthor() &&
        request.resource.data.authorId == resource.data.authorId;
      allow delete: if isAuthor();
      match /questions/{questionId} {
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }
        allow read: if parentPost().published == true ||
          (signedIn() && parentPost().authorId == request.auth.uid);
        allow create: if signedIn() && parentPost().published == true &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0;
        allow update: if signedIn() &&
          parentPost().authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.text == resource.data.text;
        allow delete: if signedIn() &&
          (parentPost().authorId == request.auth.uid ||
           resource.data.authorId == request.auth.uid);
      }
    }
  }
}